#!/usr/bin/env bash
# shared-ci's own verification entry (same entry for .githooks/pre-push and CI).
#   scripts/verify         all suites (the suites are fast; no layer selection)
#   scripts/verify --all   same
# Uses only python3 (3.9+) stdlib, git and POSIX shell.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
python="${PYTHON:-python3}"

step() { printf '\n[verify] %s\n' "$*"; }

step "syntax"
for entry in audit audit-selected resolve layers field contexts run; do
    /bin/sh -n "scripts/context/$entry"
done
for script in scripts/verify scripts/review/*.sh scripts/ruleset/apply.sh templates/scripts/verify templates/githooks/pre-push templates/githooks/pre-commit .githooks/pre-push .githooks/pre-commit; do
    bash -n "$root/$script"
done
"$python" -I -B -c 'import ast, pathlib, py_compile, sys; [ast.parse(pathlib.Path(p).read_bytes(), p) for p in sys.argv[1:]]' $(git ls-files '*.py')
"$python" -I -B -c 'import json, pathlib, sys; [json.loads(pathlib.Path(p).read_text(encoding="utf-8")) for p in sys.argv[1:]]' $(git ls-files '*.json')

step "layer map + repository contract (selected provider, live root)"
scripts/context/audit-selected

step "workflow-lint (self-applied)"
"$python" -I -B scripts/lint/workflows.py --root .

step "unit tests"
python_bin="$python"
suite_queue=()
enqueue_suite() {
    suite_queue+=("$python_bin" "$@" "")
}
python=enqueue_suite
for suite in context repo lint review ruleset select stuck_pr; do
    "$python" -I -B -m unittest discover -s "tests/$suite" -p 'test_*.py'
done
"$python" -I -B -m unittest discover -s tests/quality -p 'test_gate.py'
"$python" -I -B -m unittest discover -s tests/quality -p 'test_test_integrity.py'
"$python" -I -B -m unittest discover -s tests/quality -p 'test_commit_identity.py'
"$python" -I -B -m unittest discover -s tests/quality -p 'test_release_sync.py'
"$python" -I -B -m unittest discover -s tests/quality -p 'test_security_scan.py'
"$python" -I -S -B -m unittest discover -s tests/policy -p 'test_validation.py'
"$python" -I -S -B tests/quality/test_aggregation.py
python="$python_bin"
# With python3 -c, sys.argv[0] is "-c"; the arguments after the program are sys.argv[1:].
"$python" -I -B -c '
import concurrent.futures
import os
import subprocess
import sys

raw_jobs = os.environ.get("VERIFY_JOBS", "4").strip()
try:
    jobs = int(raw_jobs)
except ValueError:
    sys.stderr.write(f"[verify] invalid VERIFY_JOBS: {raw_jobs}\n")
    sys.exit(2)
if jobs < 1:
    sys.stderr.write(f"[verify] VERIFY_JOBS must be >= 1: {jobs}\n")
    sys.exit(2)

suites: list[list[str]] = []
current: list[str] = []
for arg in sys.argv[1:]:
    if arg == "":
        if current:
            suites.append(current)
            current = []
    else:
        current.append(arg)
if current:
    suites.append(current)

def run_suite(cmd: list[str]) -> tuple[int, str, str]:
    proc = subprocess.run(cmd, text=True, capture_output=True, check=False)
    return proc.returncode, proc.stdout, proc.stderr

failed = False
with concurrent.futures.ThreadPoolExecutor(max_workers=min(len(suites), jobs)) as pool:
    futures = [pool.submit(run_suite, cmd) for cmd in suites]
    for future in futures:
        rc, out, err = future.result()
        if out:
            sys.stdout.write(out)
            sys.stdout.flush()
        if err:
            sys.stderr.write(err)
            sys.stderr.flush()
        if rc != 0:
            failed = True
if failed:
    sys.exit(1)
' "${suite_queue[@]}"

step "whitespace"
git diff --check "$(git hash-object -t tree /dev/null)" HEAD -- . ':!*.patch' >/dev/null

echo "[verify] ok"
