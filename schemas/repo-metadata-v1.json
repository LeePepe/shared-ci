{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Index-only repository metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repo_class", "guide", "shared_ci", "dependencies"],
  "properties": {
    "schema": {"const": 1},
    "repo_class": {
      "type": "string",
      "enum": ["product", "shared"],
      "description": "Repository class: product (contract minimum only) or shared (minimum plus category-mapped paths)."
    },
    "guide": {"type": "string", "description": "Tracked repository-relative guide; no parent traversal or symlink."},
    "shared_ci": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dependencies": {
      "type": "object",
      "propertyNames": {"not": {"const": "shared-ci"}},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "ai"],
        "properties": {
          "version": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)(?![\\s\\S])"},
          "ai": {"type": "string", "pattern": "^https://", "description": "Version-specific /<version>/ai/ URL."}
        }
      }
    },
    "codeowners": {
      "type": "object",
      "description": "Category mapping for CODEOWNERS paths in shared repositories.",
      "additionalProperties": false,
      "properties": {
        "cross_repo_contract": {
          "type": "array",
          "items": {"type": "string", "pattern": "^/"},
          "uniqueItems": true
        },
        "gate_review": {
          "type": "array",
          "items": {"type": "string", "pattern": "^/"},
          "uniqueItems": true
        },
        "release_signing": {
          "type": "array",
          "items": {"type": "string", "pattern": "^/"},
          "uniqueItems": true
        },
        "privacy_credentials": {
          "type": "array",
          "items": {"type": "string", "pattern": "^/"},
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"repo_class": {"const": "product"}}
      },
      "then": {
        "properties": {
          "codeowners": {
            "type": "object",
            "properties": {
              "cross_repo_contract": {"maxItems": 0},
              "gate_review": {"maxItems": 0},
              "release_signing": {"maxItems": 0},
              "privacy_credentials": {"maxItems": 0}
            }
          }
        }
      }
    }
  ]
}
